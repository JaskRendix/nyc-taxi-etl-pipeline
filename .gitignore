# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pkl
*.pickle

# Byte-compiled / optimized / DLL files
*.so
*.dll
*.dylib

# Virtual environment
venv/
.env/
.venv/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# --- Data files ---
# Ignore large raw datasets
data/*.parquet
data/*.csv
data/*.json
data/*.zip

# But keep sample data
!data/sample_yellowcab.csv

# --- Output ---
output/
reports/
figures/

# --- Environment / config ---
.env
*.env
backend/.env
frontend/.env

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pytest cache
.pytest_cache/

# MyPy / type checking
.mypy_cache/

# Build / packaging
build/
dist/
*.egg-info/

# --- Node / TypeScript / Frontend ---

# Global node modules and locks
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
package-lock.json
yarn.lock
pnpm-lock.yaml

# Backend (Node + Prisma)
backend/node_modules/
backend/dist/
backend/.tsbuildinfo
backend/prisma/migrations/
backend/node_modules/.prisma/
backend/prisma/client/

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# TypeScript build info
*.tsbuildinfo
